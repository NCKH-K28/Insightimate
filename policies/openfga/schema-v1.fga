model
  schema 1.1

type user

type org
  relations
    # roles
    define ORG_OWNER: [user]
    define ORG_ADMIN: [user]
    define ORG_MEMBER: [user]
  
    # permissions
    define manage: ORG_OWNER
    define read: manage or ORG_ADMIN or ORG_MEMBER

type team
  relations
    define parent: [org]

    # roles
    define TEAM_LEAD: [user]
    define TEAM_MEMBER: [user]
    
    # permissions
    define manage: manage from parent or TEAM_LEAD
    define read: TEAM_MEMBER or manage

type proj_role
  relations
    define parent: [proj]
    define child: [user, team#TEAM_MEMBER]

    # permissions
    define manage: manage from parent
    define read: manage or child

type proj
  relations
    define parent: [org]
    define child: [proj_role]
    
    define PROJ_LEAD: [user]
    define PROJ_MEMBER: [user]

    # permissions
    define manage: manage from parent or PROJ_LEAD
    define read: manage or read from child or PROJ_MEMBER