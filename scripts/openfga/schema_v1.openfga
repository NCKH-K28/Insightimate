model
  schema 1.1

type user

type workspace
  relations
    # roles
    define WS_OWNER: [user]
    define WS_ADMIN: [user]
    define WS_MEMBER: [user]

    # permissions
    define can_delete: WS_OWNER
    define can_view: can_delete or WS_ADMIN or WS_MEMBER

type team
  relations
    define parent: [workspace]

    # roles
    define TEAM_LEAD: [user]
    define TEAM_MEMBER: [user]
    
    # permissions
    define can_delete: can_delete from parent or TEAM_LEAD
    define can_view: TEAM_MEMBER or can_delete

type project_permission
  relations
    define parent: [project]

type project_role
  relations
    define parent: [project]
    define child: [user, team#TEAM_MEMBER]
    define grants: [project_permission]

    # permissions
    define can_delete: can_delete from parent
    define can_view: can_delete or child

type project
  relations
    define parent: [workspace]
    define child: [project_role]
    
    define PROJ_LEAD: [user]
    define PROJ_MEMBER: [user]

    # permissions
    define can_delete: can_delete from parent or PROJ_LEAD
    define can_view: can_delete or can_view from child or PROJ_MEMBER

# For Board (Kanban|Scrum) feature
