# ==========================================
# 1. SERVER & INFRASTRUCTURE
# ==========================================
APP_URL="http://localhost:3000"
SERVER_HOST="localhost"

# ==========================================
# 2. DATABASE (POSTGRESQL)
# ==========================================
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="postgres"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}"

# ==========================================
# 3. STORAGE & SEARCH
# ==========================================
# AWS Settings
AWS_REGION=""
AWS_ACCESS_KEY_ID="minioadmin"
AWS_SECRET_ACCESS_KEY="minioadmin"
AWS_S3_ENDPOINT_URL="http://localhost:9000"
AWS_S3_BUCKET_NAME="uploads"
FILE_SIZE_LIMIT=5242880
ELASTICSEARCH_NODE="http://localhost:9200"

# ==========================================
# 4. MESSAGE BROKER & CDC
# ==========================================
KAFKA_BROKERS="localhost:9094"
DEBEZIUM_HOST="http://localhost:8083"
CDC_TOPIC="postgres-server.public.users"

# ==========================================
# 5. AUTHENTICATION & AUTHORIZATION
# ==========================================
BETTER_AUTH_SECRET=
GITHUB_TOKEN=
CERBOS_API_URL="http://localhost:3592"

# -- OPENFGA --
FGA_POSTGRES_USER="postgres"
FGA_POSTGRES_PASSWORD="postgres"
FGA_POSTGRES_DB="postgres"
FGA_POSTGRES_HOST="localhost"
FGA_POSTGRES_PORT=5432
FGA_API_URL="http://localhost:8080"
FGA_STORE_ID=
FGA_DATASTORE_ENGINE="postgres"
FGA_DATASTORE_URI="postgres://${FGA_POSTGRES_USER}:${FGA_POSTGRES_PASSWORD}@${FGA_POSTGRES_HOST}:${FGA_POSTGRES_PORT}/${FGA_POSTGRES_DB}?sslmode=disable"

# ==========================================
# 6. AI & LLM PROVIDERS
# ==========================================
SELECTED_PROVIDER=openai
OPENAI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
COPILOT_API_KEY=
HF_TOKEN=
TAVILY_API_KEY=

# ==========================================
# 7. MAIL SERVICE
# ==========================================
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=