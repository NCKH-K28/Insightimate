  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next && pnpm dev",
    "build": "pnpm run prisma:gen && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ci": "vitest run --reporter=default",
    "check": "pnpm -s run format && pnpm -s run lint && pnpm -s run typecheck && pnpm -s run test:ci",
    "check:fast": "pnpm -s run lint && pnpm -s run typecheck",
    "prisma:gen": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:reset": "prisma db push reset --force-reset",
    "prisma:studio": "prisma studio",
    "worker:dev": "tsx watch workers/index.ts",
    "worker:start": "tsx workers/index.ts",
    "deps:why": "pnpm why",
    "deps:check": "pnpm install --resolution-only",
    "deps:scan": "pnpm -s dlx tsx scripts/deps-usage-scan.ts",
    "postinstall": "prisma generate"
  },
