// Mô tả domain
// Ai Agents và các nguồn dữ liệu được sử dụng để phân tích

model AIFileRef {
    id        String   @id
    name      String
    url       String
    metadata  Json?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Agent {
    id          String  @id
    name        String
    leadId      String
    workspaceId String
    description String?

    sources    AgentSource[]
    aiAnalyses AIAnalysis[]
}

enum AgentSourceType {
    PROJECT
    DOCUMENT
    FILE
}

enum AgentSourceStatus {
    PENDING
    PROCESSING
    READY
    FAILED
}

model AgentSource {
    id         String          @id
    agentId    String
    sourceType AgentSourceType
    sourceId   String

    status AgentSourceStatus @default(PENDING)

    source Json? // metadata tóm tắt nguồn (tên, mô tả ngắn, loại nguồn, v.v.)

    agent      Agent        @relation(fields: [agentId], references: [id])
    aiAnalyses AIAnalysis[] @relation("AIAnalysisToAgentSource")

    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt
    removedAt   DateTime?
    processedAt DateTime?

    // -- internal fields --
    hidden Boolean @default(false) // an khi nguoi dung cap nhat quyen truy cap nguon

    @@unique([agentId, sourceType, sourceId])
}

enum AIAnalysisStatus {
    PENDING
    PROCESSING
    COMPLETED
    FAILED
}

model AIAnalysis {
    id        String  @id
    agentId   String
    aSourceId String?
    result    Json?

    status      AIAnalysisStatus @default(PENDING)
    processedAt DateTime?

    agent       Agent        @relation(fields: [agentId], references: [id])
    agentSource AgentSource? @relation("AIAnalysisToAgentSource", fields: [aSourceId], references: [id], onDelete: SetNull)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}
