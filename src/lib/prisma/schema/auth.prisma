model User {
  id                      String          @id @default(cuid())
  email                   String          @unique
  name                    String
  emailVerified           Boolean
  image                   String?
  avatar                  String?
  createdAt               DateTime        @default(now()) @map("created_at")
  updatedAt               DateTime        @updatedAt @map("updated_at")
  accounts                Account[]
  activityEventsAsActor   ActivityEvent[] @relation("UserActivityEventsAsActor")
  aiAgents                AIAgent[]       @relation("UserAIAgents")
  comments                Comment[]       @relation("UserComments")
  archivedIssues          Issue[]         @relation("IssueArchivedBy")
  assignedIssues          Issue[]         @relation("IssueAssignee")
  reportedIssues          Issue[]         @relation("IssueReporter")
  sentOrgInvitations      OrgInvitation[] @relation("OrgInvitationsSent")
  organizationMemberships OrgMember[]     @relation("UserOrgMemberships")
  ownedOrganizations      Organization[]  @relation("OrganizationOwner")
  leadProjects            Project[]       @relation("ProjectLead")
  projectFavorites        ProjectFavorite[] @relation("UserProjectFavorites")
  sessions                Session[]
  teamMemberships         TeamMember[]    @relation("UserTeamMemberships")
  ledTeams                Team[]          @relation("UserLedTeams")

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}
