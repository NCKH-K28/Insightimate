// prisma/schema/auth.prisma
// DOMAIN: Authentication and Authorization

model Account {
    email      String @id
    credential String

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    // Relations
    user User @relation("UserAuthAccount", fields: [email], references: [email])
}

model User {
    id     String  @id @default(cuid())
    email  String  @unique
    name   String
    avatar String?

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    // Auth
    account Account? @relation("UserAuthAccount")

    // Organizations
    ownedOrganizations      Organization[]  @relation("OrganizationOwner")
    organizationMemberships OrgMember[]     @relation("UserOrgMemberships")
    sentOrgInvitations      OrgInvitation[] @relation("OrgInvitationsSent")

    // Teams
    teamMemberships TeamMember[] @relation("UserTeamMemberships")
    ledTeams        Team[]       @relation("UserLedTeams")

    // Projects / Issues
    leadProjects   Project[] @relation("ProjectLead")
    reportedIssues Issue[]   @relation("IssueReporter")
    assignedIssues Issue[]   @relation("IssueAssignee")
    archivedIssues Issue[]   @relation("IssueArchivedBy")

    // Collab / AI
    comments Comment[] @relation("UserComments")
    aiAgents AIAgent[] @relation("UserAIAgents")

    @@map("users")
}
