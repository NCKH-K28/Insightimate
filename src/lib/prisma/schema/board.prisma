enum BoardType {
    SCRUM
    KANBAN
}

model Board {
    id          String    @id
    projectId   String    @unique
    name        String?
    description String?
    type        BoardType
    ownerId     String

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    project Project       @relation("ProjectBoard", fields: [projectId], references: [id], onDelete: Cascade)
    columns BoardColumn[] @relation("BoardColumns")
    sprints Sprint[]
    issues  BoardIssue[]

    @@map("boards")
}

model BoardIssue {
    issueId  String  @id
    boardId  String
    sprintId String?

    rank Decimal

    board  Board   @relation(fields: [boardId], references: [id], onDelete: Cascade)
    issue  Issue   @relation("IssueBoards", fields: [issueId], references: [id], onDelete: Cascade)
    sprint Sprint? @relation(fields: [sprintId], references: [id], onDelete: Cascade)

    @@unique([issueId, boardId])
    @@map("board_issues")
}

model BoardColumn {
    id       String @id
    name     String
    boardId  String
    sequence Int    @default(0)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    board    Board          @relation("BoardColumns", fields: [boardId], references: [id], onDelete: Cascade)
    statuses ColumnStatus[]

    @@unique([boardId, name])
    @@index([boardId, sequence])
    @@map("board_columns")
}

model ColumnStatus {
    columnId String
    statusId String

    column BoardColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
    status IssueStatus @relation(fields: [statusId], references: [id], onDelete: Cascade)

    @@unique([columnId, statusId])
    @@map("column_statuses")
}

enum SprintState {
    FUTURE // Sprint is planned but not started
    ACTIVE // Sprint is currently in progress
    CLOSED // Sprint has been completed
}

model Sprint {
    id          String      @id
    sequence    Int         @default(0)
    name        String
    goal        String?
    description String?
    state       SprintState
    boardId     String

    // -- Sprint Planning
    startAt DateTime?
    endAt   DateTime?

    // -- Actual (internal) 
    startedAt DateTime?
    endedAt   DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    board       Board         @relation(fields: [boardId], references: [id], onDelete: Cascade)
    issues      SprintIssue[] @relation("SprintIssue")
    boardIssues BoardIssue[]

    @@map("sprints")
}

model SprintIssue {
    issueId  String @id
    sprintId String

    rank Decimal?

    issue  Issue  @relation("SprintIssue", fields: [issueId], references: [id], onDelete: Cascade)
    sprint Sprint @relation("SprintIssue", fields: [sprintId], references: [id], onDelete: Cascade)

    @@map("sprint_issues")
}
