model Board {
  id          String        @id
  projectId   String        @unique @map("project_id")
  name        String?
  description String?
  type        BoardType
  ownerId     String        @map("owner_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  columns     BoardColumn[] @relation("BoardColumns")
  issues      BoardIssue[]
  project     Project       @relation("ProjectBoard", fields: [projectId], references: [id], onDelete: Cascade)
  sprints     Sprint[]

  @@map("boards")
}

model BoardIssue {
  issueId  String  @id @map("issue_id")
  boardId  String  @map("board_id")
  sprintId String? @map("sprint_id")
  rank     Decimal
  board    Board   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  sprint   Sprint? @relation(fields: [boardId, sprintId], references: [boardId, id], onDelete: Cascade)
  issue    Issue   @relation("IssueBoards", fields: [issueId], references: [id], onDelete: Cascade)

  @@map("board_issues")
}

model BoardColumn {
  id        String         @id
  name      String
  boardId   String         @map("board_id")
  sequence  Int            @default(0)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  board     Board          @relation("BoardColumns", fields: [boardId], references: [id], onDelete: Cascade)
  statuses  ColumnStatus[]

  @@unique([boardId, name])
  @@index([boardId, sequence])
  @@map("board_columns")
}

model ColumnStatus {
  id       String      @id @default(cuid())
  columnId String      @map("column_id")
  statusId String      @map("status_id")
  column   BoardColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  status   IssueStatus @relation(fields: [statusId], references: [id], onDelete: Cascade)

  @@unique([columnId, statusId])
  @@map("column_statuses")
}

model Sprint {
  id              String       @id
  sequence        Int          @default(0)
  name            String
  goal            String?
  description     String?
  state           SprintState
  boardId         String       @map("board_id")
  startAt         DateTime?    @map("start_at")
  endAt           DateTime?    @map("end_at")
  startedAt       DateTime?    @map("started_at")
  endedAt         DateTime?    @map("ended_at")
  committedPoints Decimal?     @map("committed_points")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  boardIssues     BoardIssue[]
  board           Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@unique([boardId, id])
  @@map("sprints")
}

enum BoardType {
  SCRUM
  KANBAN
}

enum SprintState {
  FUTURE
  ACTIVE
  CLOSED
}
