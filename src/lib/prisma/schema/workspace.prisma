// -- WORKSPACE SERVICE
// -- ======================================================
model Workspace {
    id      String @id
    name    String
    ownerId String

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    removedAt DateTime?

    owner    User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
    members  WorkspaceMember[] @relation("WorkspaceMembers")
    projects Project[]         @relation("WorkspaceProjects")
    plans    Plan[]            @relation("WorkspacePlans")
    teams    Team[]            @relation("WorkspaceTeams")

    @@map("workspaces")
}

enum WorkspaceRole {
    WS_ADMIN
    WS_MEMBER
}

model WorkspaceMember {
    id          String        @id
    workspaceId String
    userId      String
    role        WorkspaceRole

    workspace Workspace @relation("WorkspaceMembers", fields: [workspaceId], references: [id], onDelete: Cascade)
    user      User      @relation("WorkspaceMembers", fields: [userId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([workspaceId, userId])
    @@map("workspace_members")
}
