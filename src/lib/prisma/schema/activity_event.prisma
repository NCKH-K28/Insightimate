model ActivityEvent {
  id           String         @id @default(cuid())
  orgId        String         @map("org_id")
  projectId    String?        @map("project_id")
  actorId      String?        @map("actor_id")
  actorName    String?        @map("actor_name")
  actorType    String         @default("USER") @map("actor_type")
  action       ActivityAction
  entity       ActivityEntity
  entityId     String         @map("entity_id")
  entityKey    String?        @map("entity_key")
  entityTitle  String?        @map("entity_title")
  changes      Json?          @db.Json
  metadata     Json?          @db.Json
  groupKey     String?        @map("group_key")
  createdAt    DateTime       @default(now()) @map("created_at")
  actor        User?          @relation("UserActivityEventsAsActor", fields: [actorId], references: [id])
  organization Organization   @relation("OrganizationActivityEvents", fields: [orgId], references: [id], onDelete: Cascade)
  project      Project?       @relation("ProjectActivityEvents", fields: [projectId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([projectId, createdAt])
  @@index([actorId, createdAt])
  @@index([entity, entityId, createdAt])
  @@map("activity_events")
}

enum ActivityAction {
  CREATED
  UPDATED
  DELETED
  MOVED
  ASSIGNED
  UNASSIGNED
  COMMENTED
  LOGGED_TIME
  STATUS_CHANGED
  SPRINT_STARTED
  SPRINT_CLOSED
  MEMBER_ADDED
  MEMBER_REMOVED
  ROLE_CHANGED
}

enum ActivityEntity {
  PROJECT
  ISSUE
  SPRINT
  COMMENT
  TEAM
  ORGANIZATION
}
