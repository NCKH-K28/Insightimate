model Organization {
  id             String          @id @default(cuid())
  slug           String          @unique
  name           String
  ownerId        String
  logo           String?
  settings       Json            @db.Json
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  removedAt      DateTime?       @map("removed_at")
  activityEvents ActivityEvent[] @relation("OrganizationActivityEvents")
  invitations    OrgInvitation[] @relation("OrganizationInvitations")
  members        OrgMember[]     @relation("OrganizationMembers")
  owner          User            @relation("OrganizationOwner", fields: [ownerId], references: [id])
  plans          Plan[]          @relation("OrganizationPlans")
  projects       Project[]       @relation("OrganizationProjects")
  teams          Team[]          @relation("OrganizationTeams")

  @@map("organizations")
}

model OrgMember {
  id           String       @id @default(cuid())
  orgId        String       @map("org_id")
  userId       String       @map("user_id")
  role         OrgRole      @default(ORG_MEMBER)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  organization Organization @relation("OrganizationMembers", fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation("UserOrgMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@map("org_members")
}

model OrgInvitation {
  id           String              @id @default(cuid())
  orgId        String              @map("org_id")
  email        String
  role         OrgRole             @default(ORG_MEMBER)
  status       OrgInvitationStatus @default(PENDING)
  token        String              @unique
  expiresAt    DateTime            @map("expires_at")
  revokedAt    DateTime?           @map("revoked_at")
  acceptedAt   DateTime?           @map("accepted_at")
  rejectedAt   DateTime?           @map("rejected_at")
  invitedBy    String              @map("invited_by")
  payload      Json?               @db.Json
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  inviter      User                @relation("OrgInvitationsSent", fields: [invitedBy], references: [id], onDelete: SetNull)
  organization Organization        @relation("OrganizationInvitations", fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, email], name: "orgId_email")
  @@map("org_invites")
}

enum OrgRole {
  ORG_OWNER
  ORG_ADMIN
  ORG_MEMBER
}

enum OrgInvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  REVOKED
}
