model AIAgent {
  id            String        @id
  name          String
  description   String?
  ownerId       String        @map("owner_id")
  orgId         String        @map("org_id")
  tags          String[]      @default([])
  model         String?
  instructions  String?
  configuration Json?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  memories      AgentMemory[]
  traces        AgentTrace[]
  analyses      Analysis[]
  owner         User          @relation("UserAIAgents", fields: [ownerId], references: [id], onDelete: Cascade)
  dataSources   DataSource[]

  @@map("analysis_agents")
}

model FileReference {
  id        String   @id
  filename  String
  key       String
  url       String?
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("file_references")
}

model DataSource {
  id         String           @id
  agentId    String
  sourceType DataSourceType   @map("source_type")
  sourceId   String           @map("source_id")
  status     DataSourceStatus
  snapshot   Json?
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  isHidden   Boolean          @default(false)
  analyses   Analysis[]
  aiAgent    AIAgent          @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, sourceType, sourceId])
  @@map("data_sources")
}

model Analysis {
  id           String         @id
  agentId      String         @map("agent_id")
  dataSourceId String?        @map("data_source_id")
  runStatus    AnalysisStatus @default(PENDING) @map("run_status")
  type         AnalysisType   @map("type")
  version      Int            @default(1)
  output       Json?
  metrics      Json?
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  processedAt  DateTime?      @map("processed_at")
  agent        AIAgent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  dataSource   DataSource?    @relation(fields: [dataSourceId], references: [id])

  @@map("analyses")
}

model AgentMemory {
  id        String   @id @default(uuid())
  agentId   String   @map("agent_id")
  content   String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")
  agent     AIAgent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("agent_memories")
}

model AgentTrace {
  id          String   @id @default(uuid())
  runId       String   @map("run_id")
  agentId     String?  @map("agent_id")
  userId      String   @map("user_id")
  input       String
  plan        Json?
  steps       Json?
  finalOutput String?  @map("final_output")
  durationMs  Int?     @map("duration_ms")
  status      String   @default("SUCCESS")
  createdAt   DateTime @default(now()) @map("created_at")
  agent       AIAgent? @relation(fields: [agentId], references: [id])

  @@index([runId])
  @@index([userId])
  @@map("agent_traces")
}

enum DataSourceType {
  PROJECT
  FILE

  @@map("data_source_type")
}

enum DataSourceStatus {
  READY
  PENDING
  PROCESSING
  COMPLETED
  FAILED

  @@map("data_source_status")
}

enum AnalysisStatus {
  READY
  PENDING
  PROCESSING
  COMPLETED
  FAILED

  @@map("analysis_status")
}

enum AnalysisType {
  SUMMARY
  INSIGHT_EXTRACTION
  ANOMALY_DETECTION
  ESTIMATION

  @@map("analysis_type")
}
