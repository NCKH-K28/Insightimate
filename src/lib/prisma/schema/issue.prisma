model Issue {
  id               String           @id
  key              String
  summary          String
  description      String?
  typeId           String           @map("type_id")
  statusId         String           @map("status_id")
  priorityId       String           @map("priority_id")
  projectId        String           @map("project_id")
  resolutionId     String?          @map("resolution_id")
  reporterId       String?          @map("reporter_id")
  assigneeId       String?          @map("assignee_id")
  parentId         String?          @map("parent_id")
  dueDate          DateTime?        @map("due_date")
  startDate        DateTime?        @map("start_date")
  resolvedAt       DateTime?        @map("resolved_at")
  archived         Boolean          @default(false)
  archivedAt       DateTime?        @map("archived_at")
  archivedBy       String?          @map("archived_by")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  storyPoints      Float?           @map("story_points")
  originalEstimate Float?           @map("original_estimate")
  timeSpent        Float?           @map("time_spent")
  boards           BoardIssue?      @relation("IssueBoards")
  links            IssueLink[]      @relation("IssueLinkSource")
  linkedBy         IssueLink[]      @relation("IssueLinkTarget")
  archivedUser     User?            @relation("IssueArchivedBy", fields: [archivedBy], references: [id], onDelete: Cascade)
  assignee         User?            @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  project          Project          @relation("ProjectIssues", fields: [projectId], references: [id], onDelete: Cascade)
  parent           Issue?           @relation("IssueParent", fields: [projectId, parentId], references: [projectId, id], onDelete: Cascade)
  subIssues        Issue[]          @relation("IssueParent")
  priority         IssuePriority    @relation("IssuePriority", fields: [projectId, priorityId], references: [projectId, id], onDelete: Cascade)
  resolution       IssueResolution? @relation("IssueResolution", fields: [projectId, resolutionId], references: [projectId, id], onDelete: Cascade)
  status           IssueStatus      @relation("IssueStatus", fields: [projectId, statusId], references: [projectId, id], onDelete: Cascade)
  type             IssueType        @relation("IssueType", fields: [projectId, typeId], references: [projectId, id], onDelete: Cascade)
  reporter         User?            @relation("IssueReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  notifications    Notification[]   @relation("IssueNotifications")
  labels           IssueLabel[]     @relation("IssueLabels")

  @@unique([projectId, id])
  @@unique([projectId, key])
  @@map("issues")
}

model IssueLink {
  id          String        @id
  sourceId    String        @map("source_id")
  targetId    String        @map("target_id")
  linkType    IssueLinkType @map("link_type")
  description String?
  source      Issue         @relation("IssueLinkSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target      Issue         @relation("IssueLinkTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@map("issue_links")
}

model IssueType {
  id          String  @id
  sequence    Int     @default(0)
  name        String
  description String?
  iconURL     String? @map("icon_url")
  color       String?
  hierarchy   Int     @default(0)
  projectId   String  @map("project_id")
  project     Project @relation("ProjectIssueType", fields: [projectId], references: [id], onDelete: Cascade)
  issue       Issue[] @relation("IssueType")

  @@unique([projectId, id])
  @@map("issue_types")
}

model IssueStatus {
  id           String              @id
  sequence     Int                 @default(0)
  name         String
  description  String?
  iconURL      String?             @map("icon_url")
  color        String?             @map("color")
  category     IssueStatusCategory
  projectId    String              @map("project_id")
  columnStatus ColumnStatus[]
  project      Project             @relation("ProjectIssueStatus", fields: [projectId], references: [id], onDelete: Cascade)
  issue        Issue[]             @relation("IssueStatus")

  @@unique([projectId, id])
  @@map("issue_statuses")
}

model IssuePriority {
  id          String  @id
  sequence    Int     @default(0)
  name        String
  description String?
  iconURL     String? @map("icon_url")
  color       String?
  projectId   String  @map("project_id")
  issue       Issue[] @relation("IssuePriority")
  project     Project @relation("ProjectIssuePriority", fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, id])
  @@map("priorities")
}

model IssueResolution {
  id          String  @id
  sequence    Int     @default(0)
  name        String
  description String?
  iconURL     String? @map("icon_url")
  color       String?
  projectId   String  @map("project_id")
  project     Project @relation("ProjectIssueResolution", fields: [projectId], references: [id], onDelete: Cascade)
  issue       Issue[] @relation("IssueResolution")

  @@unique([projectId, id])
  @@map("issue_resolutions")
}

enum IssueStatusCategory {
  TODO
  IN_PROGRESS
  DONE
}

enum IssueLinkType {
  BLOCKS
  RELATES_TO
  DUPLICATES
}
