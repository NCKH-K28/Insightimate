// schema/plan.prisma

model Plan {
  id             String   @id
  organizationId String
  name           String
  startDate      DateTime
  endDate        DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation("OrganizationPlans", fields: [organizationId], references: [id], onDelete: Cascade)
  scenarios    Scenario[]   @relation("PlanScenarios")

  @@map("plans")
}

model Scenario {
  id        String   @id
  name      String
  planId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan   Plan            @relation("PlanScenarios", fields: [planId], references: [id], onDelete: Cascade)
  issues ScenarioIssue[] @relation("ScenarioIssues")

  @@map("scenarios")
}

model ScenarioIssue {
  id         String @id
  scenarioId String
  issueId    String

  targetStart    DateTime?
  targetEnd      DateTime?
  overAssigneeId String?

  updatedAt DateTime @updatedAt

  scenario Scenario @relation("ScenarioIssues", fields: [scenarioId], references: [id], onDelete: Cascade)

  @@map("scenario_issues")
}
