enum ActionType {
  READ
  CREATE
  UPDATE
  DELETE
}

enum EntityType {
  PROJECT
  PLAN
}

model ActivityLog {
  id         String     @id
  actorId    String
  action     ActionType
  entityType EntityType
  entityId   String

  // -- Change details
  fieldName   String? // -- Which field was changed (optional)
  oldValue    Json? // -- Previous value
  newValue    Json? // -- New value
  description String? // -- Human-readable description

  // -- Context
  context Json? // -- Additional context (e.g., project, issue)

  // -- Metadata
  // userAgent String? // -- Browser/client info
  // ipAddress String? // -- IP address
  // timestamp DateTime @default(now())

  createdAt DateTime @default(now())
}
