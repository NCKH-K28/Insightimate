model Team {
  id     String  @id @default(cuid())
  orgId  String  @map("organization_id")
  leadId String? @map("lead_id")

  name        String
  description String?
  avatar      String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation("OrganizationTeams", fields: [orgId], references: [id], onDelete: Cascade)

  memberships TeamMember[] @relation("TeamMemberships")
  lead        User?        @relation("UserLedTeams", fields: [leadId], references: [id], onDelete: Restrict)

  @@index([orgId])
  @@index([leadId])
  @@map("teams")
}

model TeamMember {
  teamId    String   @map("team_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  team Team @relation("TeamMemberships", fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation("UserTeamMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
  @@map("team_members")
}
